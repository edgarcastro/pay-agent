# Comma-separated list of sites to open (keys defined in src/sites.ts)
SITES=property

# Browser: chrome (installed Google Chrome), msedge, or chromium (run `bunx playwright install chromium` first)
BROWSER_CHANNEL=chrome

# --- property: Property management (AvalPayCenter) ---
# "2 numero de apto numero de torre" field: digits only, max 18 (e.g. 21013)
PROPERTY_REFERENCE=
# "Valor a pagar" field: digits only, no dots or $, max 19 (e.g. 350000)
PROPERTY_AMOUNT=
