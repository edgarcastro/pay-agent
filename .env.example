# pay-agent configuration. Copy to `.env` (cp .env.example .env) and fill in your values.
# Bun loads `.env` automatically. Never commit `.env`: it can hold credentials in plaintext.

# ─── General ──────────────────────────────────────────────────────────────────

# Comma-separated list of sites to open, one browser tab each.
# Valid keys (defined in src/sites.ts): altofaro, surtigas, afinia, acuacar
# Example: SITES=altofaro,surtigas
SITES=altofaro

# Browser used to open the sites:
#   chrome   - your installed Google Chrome (default)
#   msedge   - your installed Microsoft Edge
#   chromium - Playwright's bundled Chromium (run `bunx playwright install chromium` first)
BROWSER_CHANNEL=chrome

# ─── Logging ──────────────────────────────────────────────────────────────────

# Minimum level to log: trace | debug | info | warn | error | fatal | silent (default: info)
# Use `debug` to troubleshoot (e.g. see when the agent waits for a button to be enabled).
LOG_LEVEL=info

# Output format. Unset = auto: human-readable (pino-pretty) in a terminal, JSON lines when piped.
# true  = always pretty, false = always JSON (useful to ship logs to a collector).
# Secret values (e.g. passwords) are never logged.
# LOG_PRETTY=

# ─── Site: altofaro (AvalPayCenter, Conjunto Residencial Puntalta Altofaro) ───
# Fill these only if "altofaro" is in SITES. Unset fields are skipped.

# Apartment and tower number, as typed in the "2 numero de apto numero de torre" field.
# Digits only, max 18 characters. Example: 21013
ALTOFARO_REFERENCE=

# Amount to pay ("Valor a pagar"). Digits only: no dots, commas or $. Max 19 characters.
# Example: 350000
ALTOFARO_AMOUNT=

# ─── Site: surtigas (Surtigas gas, portal de recaudo) ─────────────────────────

# Contract number ("Número de contrato") printed on your gas bill. Digits only.
SURTIGAS_CONTRACT=

# ─── Site: afinia (Afinia / Caribemar electricity, login) ─────────────────────
# The agent logs in and opens the invoices page; you pick the invoice and pay.

# Email you registered on the Afinia portal.
AFINIA_EMAIL=
# Portal password. SECRET: stored in plaintext here and masked in logs. Keep this file private.
AFINIA_PASSWORD=

# ─── Site: acuacar (Acuacar water) ────────────────────────────────────────────

# Policy number ("Número de póliza") from your bill. Digits with an optional comma (e.g. 123,456).
# The agent clicks "Pagar" once you solve the reCAPTCHA.
ACUACAR_POLICY=
