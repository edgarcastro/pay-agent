{
  "name": "pay-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "verify": "bun run check && bun run typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "pino": "^10.4.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "^1.4.2",
    "husky": "9.1.7",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2"
  }
}
